    "hosting_desc": "The application is hosted via Cloudflare Pages cloud services.",
    "hosting_address_label": "Address:",
    "hosting_email_label": "Email:",
    "privacy_title": "3. Privacy & Data Handling",
    "privacy_item1_strong": "No personal data collected:",
    "privacy_item1_text": "We do not collect, store, or transmit any personal data. No login is required, and no tracking cookies are used.",
    "privacy_item2_strong": "Local storage:",
    "privacy_item2_text": "Your user preferences (e.g. elevator mode, theme, language) are stored solely in your browser's localStorage.",
