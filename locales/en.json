  "impressum": {
    "title": "About & Legal Notice",
    "what_is_title": "What is this app?",
    "what_is_p1": "BMEmap is a free, hobby university indoor map and classroom finder service. It was designed specifically for students, professors, and visitors of the Budapest University of Technology and Economics (BME) to easily navigate the campus.",
    "what_is_p2": "The application provides detailed indoor floor plans for BME's major buildings, including the Central (K) Building, Building Q, Building E, and Building I (aiming to support all buildings over time). Its goal is to help freshmen and experienced students find lecture halls, labs, buffets, and restrooms.",
    "faq_title": "Frequently Asked Questions (FAQ)",
    "faq_q1": "How does route planning work?",
    "faq_a1": "The system uses Dijkstra's algorithm to compute the shortest route between two points. It handles transitions across floors using elevators and stairs, and supports wheelchair accessible routing.",
    "faq_q2": "Which buildings are currently available?",
    "faq_a2": "Currently Buildings K, Q, and E are available (still being refined), and all campus buildings will be added over time.",
    "faq_q3": "Where does the data come from?",
    "faq_a3": "The map foundation is based on OpenStreetMap (OSM) data (mapped floor by floor). Room details, photos, and seating capacity are referenced from the official BME room database.",
    "links_title": "Useful Links",
    "link_bme": "Official BME Website",
    "link_bme_desc": "Main university portal.",
    "link_ehk": "University Student Union (EHK)",
    "link_ehk_desc": "News and student representation.",
    "link_vik": "BME VIK",
    "link_vik_desc": "Faculty of Electrical Engineering and Informatics.",
    "link_kth": "Central Academic Office (KTH)",
    "link_kth_desc": "Administration and Neptun support.",
    "operator_title": "1. Site Operator",
    "operator_desc": "This is a non-commercial community project.",
    "name_label": "Name:",
    "operator_name_val": "Godo Egyhazi",
    "operator_contact_label": "Contact:",
